# Copy to ".env" in this folder (gitignored) and uncomment/set only what needs to differ
#
# This same infrastructure/alloy/docker-compose.yml is deployed once per VPS (every
# app-service VPS + the kafka/redis VPS) — only LOKI_URL, PROMETHEUS_REMOTE_WRITE_URL, and
# APP_SCRAPE_TARGET ever need to change, and only the last one differs per VPS.

# LOKI_URL=http://loki:3100/loki/api/v1/push                  # production: monitor VPS's private IP
# PROMETHEUS_REMOTE_WRITE_URL=http://prometheus:9090/api/v1/write   # production: monitor VPS's private IP

# APP_SCRAPE_TARGET is the co-located app service's own container name:port on THIS VPS —
# leave unset on the kafka/redis VPS (no app service to scrape there). Examples:
# APP_SCRAPE_TARGET=auth-service:9000
# APP_SCRAPE_TARGET=chat-service:8083
# APP_SCRAPE_TARGET=employee-service:8086
# APP_SCRAPE_TARGET=workflow-service:8085
# APP_SCRAPE_TARGET=media-service:8082
# APP_SCRAPE_TARGET=gateway-service:8090
# APP_SCRAPE_TARGET=discovery-service:8761
