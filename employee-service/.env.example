# Copy to ".env" in this folder (gitignored) and uncomment/set only what needs to differ

# AUTH_ISSUER_URI=http://192.168.1.5:9000            # production: auth-service VPS's private IP
# DB_HOST=postgres              # production: localhost (native Postgres colocated on this VPS)
# DB_PORT=5432
# SPRING_DATA_REDIS_HOST=redis  # production: kafka+redis VPS's private IP
# SPRING_DATA_REDIS_PORT=6379
# EUREKA_URI=http://discovery-service:8761/eureka   # production: discovery-service VPS's private IP
# JWK_URI=http://auth-service:9000/oauth2/jwks       # production: auth-service VPS's private IP
# KAFKA_BOOTSTRAP_SERVERS=kafka:9092                 # production: kafka+redis VPS's private IP
# MANAGEMENT_OTLP_TRACING_ENDPOINT=http://tempo:4318/v1/traces   # production: monitor VPS's private IP
