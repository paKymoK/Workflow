# 127.0.0.1/localhost work for iOS Simulator (shares the host loopback).
# On the Android emulator they resolve to the emulator itself, not the host —
# use http://10.0.2.2:<port> instead for AUTH_SERVER/API_BASE_URL there.
AUTH_SERVER=http://127.0.0.1:9000
CLIENT_ID=workflow
CLIENT_SECRET=workflow-secret
REDIRECT_URI=com.takypok.workflow://oauth2redirect
SCOPES=openid profile offline_access
API_BASE_URL=http://localhost:8080
